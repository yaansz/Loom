    <Target Name="UnitTestProject:Make">
        <MSBuild Projects="Projects\UnitTest\UnitTestProject.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="Loom;SimpleProject;MediumProject;ComplexProject;UnitTestProject"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="Loom:Clean;SimpleProject:Clean;MediumProject:Clean;ComplexProject:Clean;UnitTestProject:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="Loom:Make;SimpleProject:Make;MediumProject:Make;ComplexProject:Make;UnitTestProject:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
